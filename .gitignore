# 환경변수 (DB 비밀번호 등)
.env

# 가상환경
.venv/

# Jupyter 임시 파일
.ipynb_checkpoints/

# Python 캐시
__pycache__/
*.py[cod]

# 데이터 파일 제외, README는 포함
data/raw/*
