data/sampled/*
!data/sampled/README.md

data/processed/*
!data/processed/README.md
!data/processed/integrated_data.csv

# 딥러닝 실험 가중치 제외
*.pt
*.pth

models/*.joblib
models/*.pkl

mysql_data/

# 앱 실행 시 자동 생성되는 로컬 실험 DB (SQLite)
data/kkeeper.db